# Example environment variables for the Telegram bot
# Rename this file to .env and fill real secrets locally (do NOT commit .env)

# Telegram bot token (from BotFather)
TELEGRAM_TOKEN=your-telegram-bot-token

# Optional: admin user ID (numeric)
ADMIN_ID=123456789

# Database URL (Postgres example)
DATABASE_URL=postgresql://dbuser:dbpass@dbhost:5432/dbname

# Optional Redis URL
REDIS_URL=redis://:redispass@redishost:6379/0

# If you use webhooks
WEBHOOK_URL=https://yourdomain.com/webhook

# Port for local/server use
PORT=8080

# Log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# Sentry (error monitoring) DSN (optional)
SENTRY_DSN=

# Other optional settings you may add:
# BOT_MODE=webhook    # or "polling"
# TIMEZONE=UTC
# EXTERNAL_API_KEY=
